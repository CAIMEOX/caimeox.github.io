\title{Euclidean Topology}
\taxon{Definition}
\import{macros}
\p{
    For #{n\geq 1}, let
    ##{
        d(x,y)=\sqrt{\sum_{i=1}^{n}(x_i-y_i)^2}
    }
    be the Euclidean distance on #{\R^n}. A subset #{U\subseteq\R^n} is
    \strong{Euclidean open} if, for every #{x\in U}, there is some
    #{\varepsilon>0} such that
    ##{
        B_\varepsilon(x)
        =\{y\in\R^n\mid d(x,y)<\varepsilon\}
        \subseteq U.
    }
    The collection of Euclidean open subsets is the \strong{Euclidean
    topology} on #{\R^n}.
}
\p{
    When #{n=1}, the open balls are open intervals. Thus a subset
    #{U\subseteq\R} is Euclidean open precisely when every #{x\in U} lies in
    an interval #{(a,b)\subseteq U}.
}
