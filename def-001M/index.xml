            <fr:display-uri>def-001O</fr:display-uri>
            <fr:route>/def-001O/</fr:route>
            <fr:title text="Antisymmetric Matrix">Antisymmetric Matrix</fr:title>
            <fr:taxon>Definition</fr:taxon>
          </fr:frontmatter>
          <fr:mainmatter>
            <html:p>
    A square matrix <fr:tex display="inline"><![CDATA[A]]></fr:tex> is antisymmetric if it is equal to the negative of its transpose:
    <fr:tex display="block"><![CDATA[
        A = -A^T
    ]]></fr:tex>
    This also implies <fr:tex display="inline"><![CDATA[A^{-1} A^T = -I]]></fr:tex></html:p>
          </fr:mainmatter>
        </fr:tree>
        <fr:tree show-metadata="true" expanded="false" toc="false" numbered="false">
          <fr:frontmatter>
            <fr:authors />
            <fr:uri>https://caimeo.space/def-001N/</fr:uri>
            <fr:display-uri>def-001N</fr:display-uri>
            <fr:route>/def-001N/</fr:route>
            <fr:title text="Symmetric Matrix">Symmetric Matrix</fr:title>
            <fr:taxon>Definition</fr:taxon>
          </fr:frontmatter>
          <fr:mainmatter>
            <html:p>
    A square matrix <fr:tex display="inline"><![CDATA[A]]></fr:tex> is symmetric if it is equal to its transpose:
    <fr:tex display="block"><![CDATA[
        A = A^T
    ]]></fr:tex>
    This also implies <fr:tex display="inline"><![CDATA[A^{-1} A^T = I]]></fr:tex></html:p>
          </fr:mainmatter>
        </fr:tree>
